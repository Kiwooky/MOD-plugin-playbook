@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

<urn:mod-cookbook:simple-echo>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-simple-echo.html> ;
        modgui:stylesheet <modgui/stylesheet-simple-echo.css> ;
        modgui:screenshot <modgui/screenshot-simple-echo.png> ;
        modgui:thumbnail <modgui/thumbnail-simple-echo.png> ;
        modgui:brand "MOD Cookbook" ;
        modgui:label "Simple Echo" ;
        modgui:port
        [ lv2:index 0 ; lv2:symbol "time" ; lv2:name "Time" ; ],
        [ lv2:index 1 ; lv2:symbol "feedback" ; lv2:name "Feedback" ; ],
        [ lv2:index 2 ; lv2:symbol "mix" ; lv2:name "Mix" ; ],
        [ lv2:index 3 ; lv2:symbol "tails" ; lv2:name "Tails" ; ] ;
    ] .
